From: Lu-Fi <noreply@users.noreply.github.com>
Date: Fri, 2 Oct 2026 07:30:00 +0200
Subject: [PATCH] sensor: t21 jxf23: track and release only the GPIOs it owns

g_chip_ident() requests the reset and power-down GPIOs every time the ISP
registers the sensor, and remove() frees both unconditionally. A second
registration (re-register after a failed detect, or a module reload while
the I2C client survived) logs "gpio request failed" and skips the reset
sequence, and remove() then frees lines this module never got (or, after
a failed request, a line another owner holds).

Remember which lines were actually requested, request each once, and free
exactly those in remove(). The reset/power-down sequence on the first
registration is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
diff --git a/common/sensor/t21/jxf23.c b/common/sensor/t21/jxf23.c
--- a/common/sensor/t21/jxf23.c
+++ b/common/sensor/t21/jxf23.c
@@ -43,6 +43,12 @@
 module_param(pwdn_gpio, int, S_IRUGO);
 MODULE_PARM_DESC(pwdn_gpio, "Power down GPIO NUM");
 
+/* GPIOs this module actually owns: requested in g_chip_ident(), released in
+ * remove() only when held, so a module reload never frees a line it does not
+ * own and never leaves one requested. */
+static bool reset_gpio_held;
+static bool pwdn_gpio_held;
+
 static int sensor_gpio_func = DVP_PA_LOW_10BIT;
 module_param(sensor_gpio_func, int, S_IRUGO);
 MODULE_PARM_DESC(sensor_gpio_func, "Sensor GPIO function");
@@ -859,9 +865,10 @@
 	struct i2c_client *client = tx_isp_get_subdevdata(sd);
 	unsigned int ident = 0;
 	int ret = ISP_SUCCESS;
-	if (reset_gpio != -1) {
+	if (reset_gpio != -1 && !reset_gpio_held) {
 		ret = private_gpio_request(reset_gpio, "sensor_reset");
 		if (!ret) {
+			reset_gpio_held = true;
 			private_gpio_direction_output(reset_gpio, 1);
 			private_msleep(50);
 			private_gpio_direction_output(reset_gpio, 0);
@@ -872,9 +879,10 @@
 			ISP_ERROR("gpio request failed %d\n", reset_gpio);
 		}
 	}
-	if (pwdn_gpio != -1) {
+	if (pwdn_gpio != -1 && !pwdn_gpio_held) {
 		ret = private_gpio_request(pwdn_gpio, "sensor_pwdn");
 		if (!ret) {
+			pwdn_gpio_held = true;
 			private_gpio_direction_output(pwdn_gpio, 1);
 			private_msleep(150);
 			private_gpio_direction_output(pwdn_gpio, 0);
@@ -1127,10 +1135,14 @@
 static int sensor_remove(struct i2c_client *client) {
 	struct tx_isp_subdev *sd = private_i2c_get_clientdata(client);
 	struct tx_isp_sensor *sensor = tx_isp_get_subdev_hostdata(sd);
-	if (reset_gpio != -1)
+	if (reset_gpio_held) {
 		private_gpio_free(reset_gpio);
-	if (pwdn_gpio != -1)
+		reset_gpio_held = false;
+	}
+	if (pwdn_gpio_held) {
 		private_gpio_free(pwdn_gpio);
+		pwdn_gpio_held = false;
+	}
 	private_clk_disable(sensor->mclk);
 	private_clk_put(sensor->mclk);
 	tx_isp_subdev_deinit(sd);
